# Shopify Storefront API
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id

# Brevo (transactional email + newsletter)
BREVO_API_KEY=
# Optional: Brevo contact list ID for newsletter subscribers (numeric)
BREVO_NEWSLETTER_LIST_ID=
# Optional overrides for contact form delivery
CONTACT_TO_EMAIL=hola@fikircafe.com
CONTACT_FROM_EMAIL=hola@fikircafe.com
